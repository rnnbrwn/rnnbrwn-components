---
// Navigation: the site header. The logo (or the site title) links home; the main links sit
// in the bar on wider screens and, on small ones (below the md breakpoint), behind a menu
// button that opens them full screen, hiding the page.
// WordPress half: rnnbrwn-base/sections/site/navigation.php (wp-admin → Navigation). The links
// come from a WordPress menu (Appearance → Menus, "Main navigation" location) or, for one-page
// sites, from sections picked by their Anchor ID. Menu items dragged under another become its
// sub-links (one level): a dropdown on wider screens, opened with the ▾ button beside the parent
// link or by hovering; listed under the parent, indented, in the small-screen menu.
//
// Put it first in <body>, and give the page's <main> the id in `mainId` so the
// "Skip to content" link has somewhere to go:
//   <Navigation data={data} cmsUrl={import.meta.env.GRAPHQL_URL} />
//   <main id="main" class="l-page">...</main>
//
// Accessibility: a skip link first; the menu button says whether the menu is open
// (aria-expanded) and which element it controls; closed links are hidden from keyboards and
// screen readers; while the full-screen menu is open the page behind is `inert` (out of reach
// of keyboards and screen readers) and can't scroll; Escape, the button or following a link
// closes it; the current page is marked (aria-current); new-tab links say so; motion follows
// prefers-reduced-motion; without JavaScript the links are simply shown. Dropdowns follow the
// "disclosure" pattern: a real button with aria-expanded (never hover-only), closed ones out of
// the tab order, Escape closes (also one shown by hovering, as WCAG 1.4.13 asks), and so do
// clicking elsewhere and tabbing out; without JavaScript they open on hover and keyboard focus.
import NewTabNote from './NewTabNote.astro';
import { linkTarget } from './html';
import { choice, surfaceClass } from './settings';
import type { NavigationData, NavigationMenuItem } from './graphql';

interface Props {
  data: NavigationData;
  cmsUrl?: string;
  mainId?: string;
  /** Label for the list of links, read out by screen readers. */
  label?: string;
}

const { data, cmsUrl, mainId = 'main', label = 'Main' } = Astro.props;
const nav = data.navigationSettings?.navigation;
const siteTitle = data.generalSettings?.title ?? '';
const width = choice(nav?.width, 'wide');
const logo = nav?.logo?.node;
const logoDark = nav?.logoDark?.node;
const menuId = 'site-navigation-menu';

const trimSlash = (path: string) => path.replace(/\/+$/, '') || '/';
const here = trimSlash(Astro.url.pathname);

const toLink = (link: NavigationMenuItem) => {
  if (!link.url) return null;
  const { attrs, newTab } = linkTarget(link, cmsUrl, Astro.site);
  // "#contact" typed into a menu means that section of the home page, from any page.
  const href = attrs.href.startsWith('#') ? `/${attrs.href}` : attrs.href;
  // Current page: a site link to this path (not an anchor within it).
  const current = href.startsWith('/') && !href.includes('#') && trimSlash(href.split('?')[0]) === here;
  // What to spread on the <a>.
  const linkAttrs = { ...attrs, href, 'aria-current': current ? ('page' as const) : undefined };
  return { title: link.label || href, newTab, current, attrs: linkAttrs };
};
type Link = NonNullable<ReturnType<typeof toLink>>;

// The links: from the WordPress menu in the "Main navigation" location, with one level of
// sub-links (items dragged under another in Appearance → Menus; deeper ones aren't shown), or
// (for one-page sites) from the sections picked in wp-admin → Navigation.
const links: (NavigationMenuItem & { children: NavigationMenuItem[] })[] =
  nav?.source === 'sections'
    ? (nav.navigationSections ?? []).map((item) => ({ url: choice(item.target, ''), label: item.label, target: null, children: [] }))
    : (data.navigationMenu?.nodes ?? []).map((item) => ({ ...item, children: item.childItems?.nodes ?? [] }));

const items = links.flatMap((item, index) => {
  const link = toLink(item);
  if (!link) return [];
  const children = item.children.map(toLink).filter((child): child is Link => !!child);
  // A parent whose sub-links include this page is marked too (visually; aria-current stays on the page's own link).
  return [{ ...link, children, subId: `${menuId}-${index}`, currentWithin: children.some((child) => child.current) }];
});
---

<header class:list={['site-nav', surfaceClass(choice(nav?.background, 'page'))]} data-site-nav>
  {/* Runs straight away, before the links are drawn, so they never flash open while the page loads. */}
  <script is:inline>document.currentScript.parentElement.setAttribute('data-enhanced', '');</script>

  <a class="site-nav__skip visually-hidden-focusable" href={`#${mainId}`}>Skip to content</a>

  <div class="l-page">
    <div class="site-nav__bar" data-width={width} data-space="none">
      <a class="site-nav__logo" href="/">
        {logo ? (
          <>
            <img
              class:list={[logoDark && 'site-nav__logo--on-light']}
              src={logo.sourceUrl}
              width={logo.mediaDetails?.width}
              height={logo.mediaDetails?.height}
              alt={siteTitle}
            />
            {logoDark && (
              <img
                class="site-nav__logo--on-dark"
                src={logoDark.sourceUrl}
                width={logoDark.mediaDetails?.width}
                height={logoDark.mediaDetails?.height}
                alt={siteTitle}
              />
            )}
          </>
        ) : (
          <span>{siteTitle}</span>
        )}
      </a>

      {items.length > 0 && (
        <>
          <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls={menuId}>
            <span class="site-nav__icon" aria-hidden="true"><span /><span /><span /></span>
            <span class="visually-hidden">Menu</span>
          </button>

          <nav id={menuId} class="site-nav__menu" aria-label={label}>
            <ul class="site-nav__links">
              {items.map((item) => (
                <li class="site-nav__item" data-current-within={item.currentWithin || undefined}>
                  {item.children.length === 0 ? (
                    <a {...item.attrs}>{item.title}<NewTabNote show={item.newTab} /></a>
                  ) : (
                    <>
                      {/* The parent is a link of its own; the button beside it opens its sub-links. */}
                      <span class="site-nav__parent">
                        <a {...item.attrs}>{item.title}<NewTabNote show={item.newTab} /></a>
                        <button type="button" class="site-nav__sub-toggle" aria-expanded="false" aria-controls={item.subId}>
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                          <span class="visually-hidden">{item.title} menu</span>
                        </button>
                      </span>
                      <ul class="site-nav__sub" id={item.subId}>
                        {item.children.map((child) => <li><a {...child.attrs}>{child.title}<NewTabNote show={child.newTab} /></a></li>)}
                      </ul>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </>
      )}
    </div>
  </div>
</header>

<script>
  // Every page's header; `md` must match the breakpoint in the styles below.
  const wide = window.matchMedia('(min-width: 48em)');

  document.querySelectorAll<HTMLElement>('[data-site-nav]').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('.site-nav__toggle');
    const menu = header.querySelector<HTMLElement>('.site-nav__menu');
    const bar = header.querySelector<HTMLElement>('.site-nav__bar');
    if (!button || !menu || !bar) return;

    // While the full-screen menu is open, everything else on the page is made inert: it can't
    // be focused, clicked or read by screen readers. Only what this adds is removed again.
    let madeInert: Element[] = [];
    const hidePage = (hide: boolean) => {
      madeInert.forEach((element) => element.removeAttribute('inert'));
      madeInert = [];
      if (!hide) return;
      for (let node: Element = header; node.parentElement && node !== document.body; node = node.parentElement) {
        for (const sibling of node.parentElement.children) {
          if (sibling !== node && !sibling.hasAttribute('inert') && sibling.tagName !== 'SCRIPT') {
            sibling.setAttribute('inert', '');
            madeInert.push(sibling);
          }
        }
      }
    };

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean, { returnFocus = false } = {}) => {
      if (open) {
        // The menu covers the screen from the top, so the bar must be at the top too: if the
        // page is scrolled a little (the header part-way off screen), bring it back into view.
        const top = header.getBoundingClientRect().top;
        if (top < 0) window.scrollBy({ top, behavior: 'instant' });
        // The links start just below the bar.
        header.style.setProperty('--site-nav-bar-bottom', `${bar.getBoundingClientRect().bottom}px`);
      }
      button.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
      hidePage(open && !wide.matches);
      if (!open && returnFocus) button.focus();
    };

    button.addEventListener('click', () => setOpen(!isOpen()));

    // ---- Sub-links (wider screens): a dropdown under the parent ----
    // It opens with its button (click, Enter or Space) or by hovering over the parent; one at a
    // time. Escape, clicking elsewhere or moving focus out of it closes it. On small screens the
    // sub-links are simply listed under their parent and these buttons are hidden.
    const subButtons = [...header.querySelectorAll<HTMLButtonElement>('.site-nav__sub-toggle')];
    const itemOf = (subButton: HTMLButtonElement) => subButton.closest<HTMLElement>('.site-nav__item')!;
    const openSub = () => subButtons.find((subButton) => subButton.getAttribute('aria-expanded') === 'true');
    // Closing hides it straight away, even under the pointer (data-dismissed, until the pointer
    // leaves or comes back); only a dropdown shown by hovering fades after the pointer leaves.
    const setSub = (subButton: HTMLButtonElement, open: boolean) => {
      subButton.setAttribute('aria-expanded', String(open));
      itemOf(subButton).toggleAttribute('data-dismissed', !open);
    };
    const closeSubs = (except?: HTMLButtonElement) =>
      subButtons.forEach((subButton) => subButton !== except && setSub(subButton, false));

    // A dropdown that would run off the right of the screen lines up with its parent's right edge instead.
    const alignSubs = () =>
      subButtons.forEach((subButton) => {
        const item = itemOf(subButton);
        item.removeAttribute('data-align');
        if (!wide.matches) return;
        const sub = item.querySelector<HTMLElement>('.site-nav__sub')!;
        if (sub.getBoundingClientRect().right > document.documentElement.clientWidth) item.setAttribute('data-align', 'end');
      });
    alignSubs();
    window.addEventListener('resize', alignSubs);

    subButtons.forEach((subButton) => {
      const item = itemOf(subButton);
      subButton.addEventListener('click', () => {
        // A click always opens a closed one, even if hovering already shows it (so it stays open when
        // the pointer leaves); clicking again closes it at once.
        const open = subButton.getAttribute('aria-expanded') !== 'true';
        closeSubs(subButton);
        setSub(subButton, open);
      });
      // Hovering one parent closes any other dropdown that was opened with its button.
      item.addEventListener('pointerenter', (event) => {
        item.removeAttribute('data-dismissed');
        if (event.pointerType === 'mouse') closeSubs(subButton);
      });
      item.addEventListener('pointerleave', () => item.removeAttribute('data-dismissed'));
      // Tabbing out of it closes it.
      item.addEventListener('focusout', (event) => {
        if (!item.contains(event.relatedTarget as Node | null)) setSub(subButton, false);
      });
    });

    // Clicking anywhere outside an open dropdown closes it.
    document.addEventListener('click', (event) => {
      const open = openSub();
      if (open && !itemOf(open).contains(event.target as Node)) setSub(open, false);
    });

    // Escape closes an open dropdown (focus goes back to its button), hides one shown by hovering,
    // or closes the full-screen menu and puts focus back on the menu button.
    // (Listened for on the whole page: someone hovering may have focus anywhere.)
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = openSub();
      const hovered = header.querySelectorAll('.site-nav__item:hover');
      if (open) {
        setSub(open, false);
        open.focus();
      } else if (wide.matches && hovered.length) {
        hovered.forEach((item) => item.setAttribute('data-dismissed', ''));
      } else if (isOpen()) {
        setOpen(false, { returnFocus: true });
      } else {
        return;
      }
      event.preventDefault();
    });

    // Following a link (e.g. to a section further down this page) closes the menu and any dropdown.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        setOpen(false);
        closeSubs();
      }
    });

    // On wider screens the links are always shown, so there's no open menu to keep.
    wide.addEventListener('change', () => {
      setOpen(false);
      closeSubs();
      alignSubs();
    });
  });
</script>

<style lang="scss">
  @use 'tools' as *;

  .site-nav {
    position: relative;
    z-index: 10;
    background-color: var(--color-bg);
    color: var(--color-text);
    border-block-end: 1px solid var(--color-border);
  }

  .site-nav__skip {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: 1;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-s);
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
  }

  .site-nav__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-xs);
  }

  .site-nav__logo {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    text-decoration: none;

    img {
      // A site can size its logo with --navigation-logo-height.
      block-size: var(--navigation-logo-height, var(--space-l));
      inline-size: auto;
    }

    // With a dark-background version, only the one that suits the surface is shown
    // (display: none also hides the other one from screen readers).
    .site-nav__logo--on-light { display: var(--display-if-light); }
    .site-nav__logo--on-dark { display: var(--display-if-dark); }
  }

  // ---------- Menu button (small screens only) ----------

  .site-nav__toggle {
    display: inline-grid;
    place-items: center;
    min-inline-size: var(--tap-target);
    min-block-size: var(--tap-target);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: transparent;
    color: inherit;
    cursor: pointer;

    // Without JavaScript there's nothing for it to do: the links are shown instead.
    .site-nav:not([data-enhanced]) & { display: none; }
  }

  // Three lines that turn into a cross.
  .site-nav__icon {
    position: relative;
    inline-size: var(--space-m);
    block-size: var(--space-m);

    > span {
      position: absolute;
      inset-inline: 10%;
      block-size: 2px;
      border-radius: 1px;
      background-color: currentColor;
      translate: 0 -50%;
      transition:
        inset-block-start var(--duration-fast) var(--ease-out),
        rotate var(--duration-fast) var(--ease-out),
        opacity var(--duration-fast) var(--ease-out);
    }
    > span:nth-child(1) { inset-block-start: 25%; }
    > span:nth-child(2) { inset-block-start: 50%; }
    > span:nth-child(3) { inset-block-start: 75%; }

    [aria-expanded='true'] & {
      > span:nth-child(1) { inset-block-start: 50%; rotate: 45deg; }
      > span:nth-child(2) { opacity: 0; }
      > span:nth-child(3) { inset-block-start: 50%; rotate: -45deg; }
    }
  }

  // ---------- Links ----------

  // Without JavaScript (and on small screens before it runs), the links sit on their own row.
  .site-nav__menu {
    flex-basis: 100%;
  }

  .site-nav__links {
    list-style: none;
    padding: 0;

    > li + li { border-block-start: 1px solid var(--color-border); }

    a {
      display: flex;
      align-items: center;
      min-block-size: var(--tap-target);
      padding-block: var(--space-2xs);
      font-size: var(--step-1);
      text-decoration: none;
      text-underline-offset: 0.25em;

      &:hover { text-decoration-line: underline; }
    }

    // The current page, and a parent whose sub-links include it.
    a[aria-current='page'],
    [data-current-within] > .site-nav__parent > a {
      font-weight: 700;
      text-decoration-line: underline;
      text-decoration-thickness: 2px;
      text-decoration-color: var(--color-accent);
    }
  }

  // ---------- Sub-links ----------
  // Small screens (and no JavaScript): listed under their parent, indented. Wider screens: a
  // dropdown (below).

  .site-nav__parent {
    display: flex;
    align-items: center;
  }

  .site-nav__sub {
    list-style: none;
    padding: 0 0 var(--space-2xs) var(--space-m);

    a { font-size: var(--step-0); }
  }

  // The ▾ button beside a parent: only on wider screens with JavaScript.
  .site-nav__sub-toggle {
    display: none;
    place-items: center;
    min-inline-size: var(--space-l);
    min-block-size: var(--tap-target);
    padding: 0;
    border: none;
    border-radius: var(--radius-s);
    background: transparent;
    color: inherit;
    cursor: pointer;

    svg {
      inline-size: var(--space-s);
      block-size: var(--space-s);
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: rotate var(--duration-fast) var(--ease-out);
    }

    &[aria-expanded='true'] svg { rotate: 180deg; }
  }

  // ---------- Small screens: the menu opens full screen ----------
  // It covers the whole screen in the navigation's own colour, hiding the page; the bar (logo
  // and close button) stays on top. It fades in and the links rise slightly into place.

  @include mq-below(md) {
    .site-nav[data-enhanced] .site-nav__menu {
      position: fixed;
      inset: 0;
      z-index: -1; // under the bar, over the page (the header is above the page)
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: var(--site-nav-bar-bottom, calc(var(--tap-target) + var(--space-xs) * 2)) var(--space-xl);
      padding-inline: var(--gutter);
      background-color: var(--color-bg);

      // Closed: invisible, and (via visibility) out of the tab order and hidden from screen readers.
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--duration-base) var(--ease-out),
        visibility 0s linear var(--duration-base);

      .site-nav__links {
        border-block-start: 1px solid var(--color-border);
        translate: 0 var(--space-s);
        transition: translate var(--duration-base) var(--ease-out);

        > li { border-block-end: 1px solid var(--color-border); }
        > li + li { border-block-start: none; }

        a {
          padding-block: var(--space-xs);
          font-size: var(--step-3);
          font-family: var(--font-heading);
        }

        .site-nav__sub a {
          padding-block: var(--space-2xs);
          font-size: var(--step-1);
          font-family: inherit;
        }
      }
    }

    .site-nav[data-enhanced][data-open] .site-nav__menu {
      visibility: visible;
      opacity: 1;
      transition-delay: 0s;

      .site-nav__links { translate: none; }
    }

    // The page behind doesn't scroll while the menu is open.
    :global(html:has(.site-nav[data-open])) {
      overflow: hidden;
    }
  }

  // ---------- Wider screens: the links sit in the bar, no menu button ----------

  // A dropdown, open (shown with its button, by hovering, or by keyboard focus without JavaScript).
  @mixin sub-open {
    visibility: visible;
    opacity: 1;
    translate: none;
    transition-delay: 0s;
  }

  @include mq(md) {
    .site-nav__toggle,
    .site-nav:not([data-enhanced]) .site-nav__toggle {
      display: none;
    }

    .site-nav__menu {
      flex-basis: auto;
    }

    .site-nav__links {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-m);

      > li + li { border: none; }

      a { font-size: var(--step-0); }
    }

    .site-nav[data-enhanced] .site-nav__sub-toggle { display: inline-grid; }

    // The dropdown: a small panel under its parent, lined up with the parent's left edge (or its
    // right edge, data-align="end", when it would run off the screen).
    .site-nav__item { position: relative; }

    .site-nav__sub {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: calc(var(--space-s) * -1);
      z-index: 1;
      min-inline-size: calc(var(--space-3xl) * 2);
      padding: var(--space-2xs);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-m);
      background-color: var(--color-bg);
      box-shadow: var(--shadow-raised);

      // Closed: invisible, and (via visibility) out of the tab order and hidden from screen
      // readers. After hovering it stays a moment (--hover-grace) so a stray pointer doesn't shut it.
      visibility: hidden;
      opacity: 0;
      translate: 0 calc(var(--space-3xs) * -1);
      transition:
        opacity var(--duration-fast) var(--ease-out) var(--hover-grace),
        translate var(--duration-fast) var(--ease-out) var(--hover-grace),
        visibility 0s linear calc(var(--hover-grace) + var(--duration-fast));

      [data-align='end'] > & {
        inset-inline-start: auto;
        inset-inline-end: 0;
      }

      a {
        padding-inline: var(--space-xs);
        border-radius: var(--radius-s);
        white-space: nowrap;

        &:hover { background-color: var(--color-card); }
      }
    }

    // Open: with its button, or while hovered (unless Escape dismissed it), or, without
    // JavaScript, while something in it has keyboard focus.
    .site-nav__parent:has([aria-expanded='true']) + .site-nav__sub,
    .site-nav:not([data-enhanced]) .site-nav__item:focus-within > .site-nav__sub {
      @include sub-open;
    }

    @media (hover: hover) {
      .site-nav__item:hover:not([data-dismissed]) > .site-nav__sub {
        @include sub-open;
      }

      .site-nav__item:hover:not([data-dismissed]) .site-nav__sub-toggle svg { rotate: 180deg; }
    }

    // Escape hides it straight away.
    [data-dismissed] > .site-nav__sub { transition: none; }
  }
</style>
