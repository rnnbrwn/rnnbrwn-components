---
// Button: one button-styled link (.button in scss/base/_buttons.scss), from an ACF link field.
// Styles: solid (the main action), outline, text (a plain link). Arrows are automatic (ButtonIcon.astro).
// Renders nothing if the link is empty. Links to the CMS's own pages become site links.
// Usually rendered by ButtonRow.astro from a component's buttons field (rs_buttons in WordPress).
import ButtonIcon from './ButtonIcon.astro';
import NewTabNote from './NewTabNote.astro';
import { linkTarget } from './html';
import type { WpLink } from './settings';

export type ButtonStyle = 'solid' | 'outline' | 'text';

interface Props {
  link: WpLink | undefined;
  style?: ButtonStyle;
  cmsUrl?: string;
}

const { link, style = 'solid', cmsUrl } = Astro.props;
const { href, newTab, external, attrs } = linkTarget(link, cmsUrl, Astro.site);
---

{href && (
  <a class:list={['button', style !== 'solid' && `button--${style}`]} {...attrs}>
    <span>{link?.title || href}</span>
    <NewTabNote show={newTab} />
    <ButtonIcon style={style} newTab={newTab} external={external} />
  </a>
)}
