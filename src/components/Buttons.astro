---
// Buttons: a row of up to three buttons on its own, e.g. after a block of text.
// WordPress half: rnnbrwn-base/sections/components/buttons.php
// Other components show buttons with ButtonRow.astro directly, from their own rs_buttons field.
import Section from '../Section.astro';
import ButtonRow from '../ButtonRow.astro';
import { choice, type ButtonsField, type Choice, type SectionSettings } from '../settings';

interface Props {
  section: SectionSettings & { buttonsButtons: ButtonsField; alignment: Choice };
  cmsUrl?: string;
}

const { section, cmsUrl } = Astro.props;
const align = choice(section.alignment, 'left') === 'centre' ? 'centre' : 'left';
---

<Section section={section} class="buttons">
  <ButtonRow buttons={section.buttonsButtons} cmsUrl={cmsUrl} align={align} />
</Section>
