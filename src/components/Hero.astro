---
// Hero: the big opening section of a page. An eyebrow, the heading, an intro and up to three
// buttons, either centred on the section's colour ("Centred") or over a photo tinted with it
// ("Background image"), in a Standard or Tall height.
// WordPress half: rnnbrwn-base/sections/components/hero.php
//
// The heading is the page's <h1> when the Hero is the page's first section (`main`), otherwise
// an <h2>. A background photo is decoration (empty alt) unless the editor turns on "Describe the
// photo to screen readers"; it's tinted with the background colour (--tint-strength) so the text
// stays readable over any photo, and it fills the section like a panel (or edge to edge at full
// width) without changing the layout.
import Section from '../Section.astro';
import ButtonRow from '../ButtonRow.astro';
import Image from '../Image.astro';
import { choice, laneSizes, sectionWidth, type ButtonsField, type Choice, type SectionSettings, type WpImage } from '../settings';

interface Props {
  section: SectionSettings & {
    variant: Choice;
    eyebrow: string | null;
    heading: string | null;
    intro: string | null;
    heroButtons: ButtonsField;
    height: Choice;
    image: WpImage;
    focus: Choice;
    imageInformative: boolean | null;
    alignment: Choice;
  };
  cmsUrl?: string;
  main?: boolean;
}

const { section, cmsUrl, main = false } = Astro.props;

const photo = choice(section.variant, 'centred') === 'background_image' ? section.image?.node : undefined;
const alignment = photo ? choice(section.alignment, 'left') : 'centre';
const tall = choice(section.height, 'standard') === 'tall';
const Heading = main ? 'h1' : 'h2';
// Which image size the browser should pick: the section's lane, or edge to edge at full width.
const sizes = sectionWidth(section) === 'full' ? '100vw' : laneSizes(section);
---

<Section
  section={section}
  class:list={['hero', photo && 'hero--photo', `hero--${alignment}`, tall && 'hero--tall']}
>
  {photo && (
    <div class="hero__media" data-focus={choice(section.focus, 'center')}>
      {/* The first section's photo is the first thing seen: load it straight away, before other images. */}
      <Image image={photo} sizes={sizes} alt={section.imageInformative ? undefined : ''} eager={main} />
    </div>
  )}

  <div class="hero__content">
    {section.eyebrow && <p class="eyebrow hero__eyebrow">{section.eyebrow}</p>}
    <Heading class="hero__heading">{section.heading}</Heading>
    {section.intro && <p class="hero__intro">{section.intro}</p>}
    <ButtonRow buttons={section.heroButtons} cmsUrl={cmsUrl} align={alignment === 'centre' ? 'centre' : 'left'} class="hero__buttons" />
  </div>
</Section>

<style lang="scss">
  @use 'tools' as *;

  .hero {
    position: relative;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--line) / 2);
  }

  .hero--centre .hero__content {
    align-items: center;
    text-align: center;
  }

  // Tall: generous space around the content, which sits in the middle.
  .hero--tall .hero__content {
    justify-content: center;
    min-block-size: calc(var(--space-3xl) * 4);
  }

  // Over a photo, dimmed text can't be relied on to stay readable: the eyebrow (.eyebrow in
  // scss/base/_text.scss) uses the full text colour.
  .hero--photo .hero__eyebrow {
    color: var(--color-text);
  }

  .hero__heading {
    max-inline-size: 22ch;
    font-size: var(--step-6);
    @include snap-leading(1.05);
  }

  .hero__intro {
    max-inline-size: var(--measure);
    font-size: var(--step-1);
  }

  // ButtonRow's own element, so reached with :global().
  // Half a line between the texts, a whole line above the buttons.
  .hero__content > :global(.hero__buttons) {
    margin-block-start: calc(var(--line) / 2);
  }

  // Over a photo, the accent colour isn't readable enough either (3.5:1 at worst): text links
  // use the full text colour, like the eyebrow.
  .hero--photo :global(.button--text) {
    color: var(--color-text);
  }

  // ---------- Background image ----------
  // The photo sits behind the content and never affects the layout. Not full width, it fills
  // the same area as a panel would (out into the gutter, rounded); full width, edge to edge.

  .hero--photo {
    isolation: isolate;
  }

  .hero__media {
    @include panel-area;
    overflow: hidden;

    // Its keep-in-view point (data-focus) is in scss/base/_base.scss.
    img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    // The tint: the background's own colour over the photo, strong enough for its text.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background-color: color-mix(in srgb, var(--color-bg) var(--tint-strength), transparent);
    }
  }

  .hero--photo[data-width='full'] .hero__media {
    grid-column: 1 / -1;
    inset: 0;
    border-radius: 0;
  }
</style>
