---
// Media Text: an image beside a block of text (an optional eyebrow, heading, editor text and up
// to three buttons). The editor picks the image's side (Left or Right), its shape (Original, or
// cropped to Landscape 3:2, Square or Portrait 4:5 around a "keep in view" point), the split
// (Half and half, Image wider or Text wider) and whether the text lines up with the image's
// top, middle or bottom. Side by side once the section is at least md (40rem) wide; narrower,
// the image sits above the text.
// WordPress half: rnnbrwn-base/sections/components/media-text.php
//
// The text comes first in the page (heading before image for screen readers); the image is
// placed with the grid. Its alt text comes from the Media Library, empty = decorative.
import Section from '../Section.astro';
import ButtonRow from '../ButtonRow.astro';
import Image from '../Image.astro';
import { editorHtml } from '../html';
import { choice, laneSizes, type ButtonsField, type Choice, type SectionSettings, type WpImage } from '../settings';

interface Props {
  section: SectionSettings & {
    image: WpImage;
    eyebrow: string | null;
    heading: string | null;
    body: string | null;
    mediaTextButtons: ButtonsField;
    imageSide: Choice;
    imageShape: Choice;
    focus: Choice;
    split: Choice;
    textAlignment: Choice;
  };
  cmsUrl?: string;
}

const { section, cmsUrl } = Astro.props;

const image = section.image?.node;
const body = editorHtml(section.body, cmsUrl, Astro.site);
const side = choice(section.imageSide, 'left') === 'right' ? 'right' : 'left';
const shape = choice(section.imageShape, 'original');
const split = choice(section.split, 'half');
const align = choice(section.textAlignment, 'middle');

// Which image size the browser should pick: its share of the section's lane, or the whole
// screen when stacked on phones.
const share = { half: 0.5, image_wider: 0.6, text_wider: 0.4 }[split] ?? 0.5;
const sizes = laneSizes(section, share);
---

<Section
  section={section}
  class:list={['media-text', `media-text--image-${side}`, `media-text--${split.replace('_', '-')}`, `media-text--align-${align}`]}
>
  <div class="media-text__inner">
    <div class="media-text__grid">
      {(section.eyebrow || section.heading || body || section.mediaTextButtons?.length) && (
        <div class="media-text__content">
          {section.eyebrow && <p class="eyebrow media-text__eyebrow">{section.eyebrow}</p>}
          {section.heading && <h2 class="media-text__heading">{section.heading}</h2>}
          {body && <div class="prose" set:html={body} />}
          <ButtonRow buttons={section.mediaTextButtons} cmsUrl={cmsUrl} class="media-text__buttons" />
        </div>
      )}

      {image && (
        <div class="media-text__media" data-shape={shape} data-focus={choice(section.focus, 'center')}>
          <Image image={image} sizes={sizes} />
        </div>
      )}
    </div>
  </div>
</Section>

<style lang="scss">
  @use 'tools' as *;

  // The container the layout measures, on an inner wrapper (not the section: a full-width
  // section is a subgrid of the page grid, and a container query can't style its own container).
  .media-text__inner {
    container-type: inline-size;
  }

  // Stacked: the image above the text.
  .media-text__grid {
    display: grid;
    gap: var(--line);
  }

  .media-text__media {
    order: -1;
  }

  // Side by side: two columns, the image's on the chosen side, sized by the split.
  @include cq(md) {
    .media-text__grid {
      --image-col: 1fr;
      --text-col: 1fr;

      grid-template-columns: var(--image-col) var(--text-col);
      column-gap: var(--space-xl);
    }

    .media-text--image-wider .media-text__grid { --image-col: 3fr; --text-col: 2fr; }
    .media-text--text-wider .media-text__grid { --image-col: 2fr; --text-col: 3fr; }

    .media-text--image-right .media-text__grid {
      grid-template-columns: var(--text-col) var(--image-col);
    }

    // Each in its own column on one row, whatever the page order.
    .media-text__media,
    .media-text__content { grid-row: 1; }
    .media-text--image-left .media-text__media { grid-column: 1; }
    .media-text--image-left .media-text__content { grid-column: 2; }
    .media-text--image-right .media-text__media { grid-column: 2; }
    .media-text--image-right .media-text__content { grid-column: 1; }

    .media-text--align-top .media-text__content { align-self: start; }
    .media-text--align-middle .media-text__content { align-self: center; }
    .media-text--align-bottom .media-text__content { align-self: end; }

    // The image stays at its own height, lined up with the text's top/middle/bottom too, so
    // a short text beside it never stretches or crops it.
    .media-text__media { align-self: start; }
    .media-text--align-middle .media-text__media { align-self: center; }
    .media-text--align-bottom .media-text__media { align-self: end; }
  }

  // ---------- The text ----------
  .media-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--line) / 2);
    min-inline-size: 0;
  }

  // Half a line between the texts, a whole line above the buttons.
  .media-text__content > :global(.media-text__buttons) {
    margin-block-start: calc(var(--line) / 2);
  }

  // ---------- The image ----------
  // Its keep-in-view point (data-focus) is in scss/base/_base.scss.
  .media-text__media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-m);
  }

  .media-text__media:not([data-shape='original']) img {
    object-fit: cover;
  }

  .media-text__media[data-shape='landscape'] img { aspect-ratio: 3 / 2; }
  .media-text__media[data-shape='square'] img { aspect-ratio: 1; }
  .media-text__media[data-shape='portrait'] img { aspect-ratio: 4 / 5; }
</style>
