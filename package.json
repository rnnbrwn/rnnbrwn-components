{
  "name": "@rnnbrwn/components",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Shared Sass layout system and Astro components for RNNBRWN sites",
  "keywords": ["astro-component"],
  "exports": {
    ".": "./integration.mjs",
    "./Sections.astro": "./src/Sections.astro",
    "./Navigation.astro": "./src/Navigation.astro",
    "./Footer.astro": "./src/Footer.astro",
    "./Button.astro": "./src/Button.astro",
